# ======================================================
# HRIS OmahVisual - Environment Variables Template
# ======================================================
# Salin file ini menjadi .env dan isi nilainya

# --- Django Core ---
#SECRET_KEY_placeholder_removed
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Development: SQLite (tidak perlu konfigurasi)
USE_SQLITE=True

# Production (uncomment saat PostgreSQL/Docker siap):
# USE_SQLITE=False
# DB_NAME=hris_omahvisual
# DB_USER=postgres
# DB_PASSWORD=ganti-password-db
# DB_HOST=localhost
# DB_PORT=5432

# --- Redis / Celery ---
# Development: pakai database backend (tidak perlu Redis)
USE_REDIS=False

# Production (uncomment saat Redis siap):
# USE_REDIS=True
# REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT ---
# Durasi access token (menit)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# Durasi refresh token (hari)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Media Files ---
MEDIA_ROOT=media/


# --- Hikvision Machine ---
HIKVISION_HOST=172.16.12.89
HIKVISION_USER=admin
HIKVISION_PASS=OmviJosjis2026
WORK_START_HOUR=8
WORK_END_HOUR=17
LATE_THRESHOLD_MINUTES=15
SECRET_KEY=django-dev-secret-key-hris-omahvisual-not-for-production

